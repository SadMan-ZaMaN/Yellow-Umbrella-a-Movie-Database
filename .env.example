# Copy this file to .env and fill it in. .env is git-ignored.

# PostgreSQL
DB_NAME=imdb_project
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Signs login tokens. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# TMDB "API Read Access Token" (the long one, not the v3 key)
# https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# RAWG API key, used for games - https://rawg.io/apidocs
RAWG_KEY=

# Optional: password reset emails. Gmail needs an App Password here.
SMTP_EMAIL=
SMTP_PASSWORD=
APP_URL=http://127.0.0.1:8000
